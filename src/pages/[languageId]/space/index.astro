---
import Layout from '../../../layouts/Layout.astro'
import Address from '@/components/molecules/Address.astro'
import Heading from '@/components/atoms/Heading.astro'
import { Image } from 'astro:assets'

import { getLangFromUrl, useTranslations } from '../../../i18n/utils'
import { thePlaceGallery } from '../../../../constants/gallery'

export async function getStaticPaths() {
	return [{ params: { languageId: 'es' } }, { params: { languageId: 'en' } }]
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout title={t('space.title')} heading='test'>
	<div class='flex flex-col wrapper text-custom-accent-200/70! gap-8 lg:gap-16'>
		<div class='flex flex-col gap-4'>
			<Heading heading={t('space.title')} />
			<div class='flex flex-col gap-0'>
				<span class='text-lg lg:text-xl leading-[1.6]'>
					{t('space.description')}
				</span>
				<a
					href='https://www.theplacedancestudiomadrid.com'
					target='_blank'
					class='text-lg lg:text-xl leading-[1.6] hover:text-custom-accent-200/80'
					>www.theplacedancestudiomadrid.com</a
				>
			</div>
		</div>

		<section class='grid hrid-cols-1 lg:grid-cols-3 gap-4'>
			{
				thePlaceGallery.map(image => (
					<Image
						src={image.src}
						alt={image.alt}
						data-full-src={image.src.src}
						class='gallery-img cursor-pointer min-h-[314px] object-cover'
					/>
				))
			}
		</section>

		<div class='flex flex-col lg:flex-row justify-between w-full gap-4'>
			<iframe
				src='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3036.738539497904!2d-3.6081518000000012!3d40.4367881!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd422f9539dafdc1%3A0x2df1b2b80e0d47ad!2sThe%20Place%20Dance%20Studio%20Madrid!5e0!3m2!1spl!2ses!4v1784814371646!5m2!1spl!2ses'
				style='border:0;'
				width='100%'
				allowfullscreen=''
				loading='lazy'
				referrerpolicy='strict-origin-when-cross-origin'></iframe>

			<Address
				street={t('address.street')}
				closeTo={t('address.near')}
				metro={t('address.metro')}
			/>
		</div>
	</div>
</Layout>
