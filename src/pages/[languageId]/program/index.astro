---
import { cn } from 'utils/twMerge'
import Layout from '../../../layouts/Layout.astro'
import Heading from '@/components/atoms/Heading.astro'
import { Image } from 'astro:assets'

import { getLangFromUrl, useTranslations } from '../../../i18n/utils'
import QuoteWithText from '@/components/molecules/QuoteWithText.astro'
import Calendar from '@/components/organisms/Calendar.astro'

export async function getStaticPaths() {
	return [{ params: { languageId: 'es' } }, { params: { languageId: 'en' } }]
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// style={`background-image: url('/images/program-background.jpg')`}
---

<Layout title={t('schedule.title')}>
	<div class='w-full flex flex-col items-center gap-8'>
		<div
			class={cn(
				'relative flex justify-center w-full lg:max-h-[500px] self-stretch bg-cover bg-no-repeat shadow-md -mt-8 z-1 bg-center'
				// teacher.bgPosition
			)}
			style={`background-image: url('/images/program-background.webp')`}
		>
			<div
				class='absolute top-0 left-0 bottom-0 right-0 bg-custom-accent-200/65 z-2'
			>
			</div>
			<div
				class='flex flex-col justify-center items-start w-full min-h-[500px] max-w-screen-2xl mb-8 lg:mb-16 px-4! lg:px-10!'
			>
				<Heading
					heading={t('schedule.welcome')}
					customClass={cn(
						'items-start  text-white z-3 text-4xl lg:text-7-4-5xl! uppercase'
					)}
				/>
			</div>
		</div>
		<QuoteWithText text={'main.quote'} />
		<Calendar />
	</div>
</Layout>

<style>
	.schedule-container {
		width: 100%;
		display: flex;
		justify-content: center;
		overflow: hidden;
	}

	.schedule-image {
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	@media (max-width: 1023px) {
		.schedule-container {
			width: 100%;

			height: calc((100vw - 2rem) * 1.4);
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: visible;

			margin-top: 8rem;
			margin-bottom: 6rem;
		}

		.schedule-image {
			transform: rotate(-90deg);

			height: calc(100vw - 2rem);
			width: auto;
			max-width: none;
			max-height: none;
		}
	}
</style>
