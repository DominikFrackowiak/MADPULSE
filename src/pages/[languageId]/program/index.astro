---
import Layout from '../../../layouts/Layout.astro'
import Heading from '@/components/atoms/Heading.astro'

import { getLangFromUrl, useTranslations } from '../../../i18n/utils'
import QuoteWithText from '@/components/molecules/QuoteWithText.astro'
import Calendar from '@/components/organisms/Calendar.astro'

export async function getStaticPaths() {
	return [{ params: { languageId: 'es' } }, { params: { languageId: 'en' } }]
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout title={t('schedule.title')}>
	<div
		class='w-full flex flex-col items-center centerElement verticalDistance gap-16 '
	>
		<!-- <StrokeTitle text={t('schedule.title')} /> -->

		<QuoteWithText text={'main.quote'} />
		<!-- <div class='schedule-container'>
			<img
				src={lang === 'es'
					? '/images/schedule_es.png'
					: '/images/schedule_en.webp'}
				alt='schedule'
				class='schedule-image rounded-3xl shadow-md'
			/>
		</div> -->
		<Heading heading='schedule.title' />
		<Calendar />
	</div>
</Layout>

<style>
	.schedule-container {
		width: 100%;
		display: flex;
		justify-content: center;
		overflow: hidden;
	}

	.schedule-image {
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	@media (max-width: 1023px) {
		.schedule-container {
			width: 100%;

			height: calc((100vw - 2rem) * 1.4);
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: visible;

			margin-top: 8rem;
			margin-bottom: 6rem;
		}

		.schedule-image {
			transform: rotate(-90deg);

			height: calc(100vw - 2rem);
			width: auto;
			max-width: none;
			max-height: none;
		}
	}
</style>
