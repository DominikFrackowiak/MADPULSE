---
import Layout from '../../../layouts/Layout.astro'
import Heading from '@/components/atoms/Heading.astro'
import PriceInfoCard from '@/components/molecules/PriceInfoCard.astro'
import ContactInfoCard from '@/components/molecules/ContactInfoCard.astro'



import { getLangFromUrl, useTranslations } from '../../../i18n/utils'

export async function getStaticPaths() {
	return [{ params: { languageId: 'es' } }, { params: { languageId: 'en' } }]
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout title={t('registration.title')}>
	<div class='flex flex-col wrapper text-custom-accent-200/70! gap-8 lg:gap-16'>
		<Heading
			heading={t('registration.title')}
			customClass='items-center lg:items-start uppercase'
		/>
		<div class='flex flex-col gap-4'>
			<Heading
				heading={t('registration.price')}
				customClass='text-2xl! items-center lg:items-start uppercase'
			/>
			<section class='flex flex-col lg:flex-row justify-between gap-4'>
				<PriceInfoCard
					title={t('registration.earlyBirds.title')}
					amount={t('registration.earlyBirds.price.amount')}
					layout='left'
					details={t('registration.earlyBirds.price.details')}
				/>
				<PriceInfoCard
					title={t('registration.regularPrice.title')}
					amount={t('registration.regularPrice.price.amount')}
					layout='right'
					details={t('registration.regularPrice.price.details')}
					isFeatured
				/>
			</section>
		</div>
		<div class='flex flex-col gap-4'>
			<Heading
				heading={t('registration.howToBook.title')}
				customClass='text-2xl! items-center lg:items-start uppercase'
			/>
			<ul class='flex flex-col gap-4'>
				<li
					class='text-left text-lg lg:text-xl'
					set:html={t('registration.howToBook.step1')}
				/>
				<div class='flex flex-col gap-4 py-4'>
					<ContactInfoCard
						name='Marta Wrzesińska'
						email='martawrze@gmail.com'
						phoneNumber='+34 647 22 90 01'
						whatsAppUrl='https://wa.me/34647229001'
					/>
					<ContactInfoCard
						name='Jesús Alonso'
						email='jesusalonsodanzaci@gmail.com'
						phoneNumber='+34 635 68 33 94'
						whatsAppUrl='https://wa.me/34635683394'
					/>
				</div>
				<li class='text-left text-lg lg:text-xl'>
					{t('registration.howToBook.step2')}
				</li>
			</ul>
		</div>
		<div class='flex flex-col gap-4'>
			<Heading
				heading={t('registration.cancellationPolicy.title')}
				customClass='text-2xl! items-center lg:items-start uppercase '
			/>
			<span class='block text-left text-lg lg:text-xl'
				>{t('registration.cancellationPolicy.text')}</span
			>
		</div>
	</div>
</Layout>
