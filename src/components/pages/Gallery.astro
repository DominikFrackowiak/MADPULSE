---
import Heading from '../atoms/Heading.astro'
import CloseIcon from '../atoms/CloseIcon.astro'
import ChevronLeftIcon from '../atoms/ChevronLeftIcon.astro'
import ChevronRightIcon from '../atoms/ChevronRightIcon.astro'
import { Image } from 'astro:assets'
import type { galleryYears } from '../../../constants/gallery'

import { getLangFromUrl, useTranslations } from '../../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

type GalleryData = (typeof galleryYears)[number]
type GalleryImage = GalleryData['images'][number]

interface Props {
	gallery: GalleryData
}

const { gallery } = Astro.props
---

<article
	class='flex flex-col wrapper text-custom-accent-200/70! gap-8 lg:gap-16'
>
	<div class='flex flex-col gap-4'>
		<Heading heading={`MADPULSE ${gallery.year}`} />
		<p class='text-custom-accent-200 w-full lg:max-w-2/3'>{t('gallery.description')}</p>
	</div>
	<section class='grid grid-cols-1 lg:grid-cols-3 gap-6'>
		{
			gallery.images.map((image: GalleryImage) => (
				<Image
					src={image.src}
					alt={image.alt}
					data-full-src={image.src.src}
					class='gallery-img cursor-pointer min-h-[314px] object-cover'
				/>
			))
		}
	</section>
	<div
		class='image-wrapper hidden justify-center items-start lg:items-center fixed top-0 bottom-0 left-0 right-0 bg-white/70 z-60 cursor-pointer text-custom-accent!'
	>
		<button
			type='button'
			aria-label='Close image preview'
			class='close-image cursor-pointer absolute top-8 right-8 z-1 flex h-10 w-10 items-center justify-center rounded-full bg-white text-custom-accent'
		>
			<CloseIcon className='h-6 w-6' />
		</button>
		<button
			type='button'
			aria-label='Show previous image'
			class='previous-image cursor-pointer absolute left-4 lg:left-8 top-1/2 z-1 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white text-custom-accent shadow-sm'
		>
			<ChevronLeftIcon className='h-8 w-8' />
		</button>
		<img src='' alt='' class='mt-40 lg:mt-0 single-image max-h-[95vh] w-auto' />
		<button
			type='button'
			aria-label='Show next image'
			class='next-image cursor-pointer absolute right-4 lg:right-8 top-1/2 z-1 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white text-custom-accent shadow-sm'
		>
			<ChevronRightIcon className='h-8 w-8' />
		</button>
	</div>
</article>

<script>
	const setupGalleryPreview = () => {
		const imgWrapper = document.querySelector<HTMLDivElement>('.image-wrapper')
		const images = Array.from(
			document.querySelectorAll<HTMLImageElement>('.gallery-img')
		)
		const singleImage =
			document.querySelector<HTMLImageElement>('.single-image')
		const previousImage =
			document.querySelector<HTMLButtonElement>('.previous-image')
		const nextImage = document.querySelector<HTMLButtonElement>('.next-image')

		if (!imgWrapper || !singleImage) return

		let currentImageIndex = 0

		const isPreviewOpen = () => imgWrapper.classList.contains('flex')

		const showImage = (index: number) => {
			const image = images[index]
			const fullSrc = image?.dataset.fullSrc

			if (!image || !fullSrc) return

			currentImageIndex = index
			singleImage.src = fullSrc
			singleImage.alt = image.alt
		}

		const openPreview = (index: number) => {
			showImage(index)
			imgWrapper.classList.remove('hidden')
			imgWrapper.classList.add('flex')
		}

		const closePreview = () => {
			imgWrapper.classList.remove('flex')
			imgWrapper.classList.add('hidden')
		}

		const showPreviousImage = () => {
			const previousIndex =
				(currentImageIndex - 1 + images.length) % images.length

			showImage(previousIndex)
		}

		const showNextImage = () => {
			const nextIndex = (currentImageIndex + 1) % images.length

			showImage(nextIndex)
		}

		images.forEach((image, index) => {
			if (image.dataset.galleryPreviewBound === 'true') return

			image.dataset.galleryPreviewBound = 'true'
			image.addEventListener(
				'click',
				() => {
					openPreview(index)
				},
				{ once: false }
			)
		})

		if (imgWrapper.dataset.galleryPreviewBound === 'true') return

		imgWrapper.dataset.galleryPreviewBound = 'true'
		imgWrapper.addEventListener('click', () => {
			closePreview()
		})

		;[singleImage, previousImage, nextImage].forEach(element => {
			element?.addEventListener('click', event => {
				event.stopPropagation()
			})
		})

		previousImage?.addEventListener('click', () => {
			showPreviousImage()
		})

		nextImage?.addEventListener('click', () => {
			showNextImage()
		})

		document.addEventListener('keydown', event => {
			if (!isPreviewOpen()) return

			if (event.key === 'ArrowLeft') {
				event.preventDefault()
				showPreviousImage()
			}

			if (event.key === 'ArrowRight') {
				event.preventDefault()
				showNextImage()
			}

			if (event.key === 'Escape') {
				closePreview()
			}
		})
	}

	setupGalleryPreview()
	document.addEventListener('astro:page-load', setupGalleryPreview)
</script>
