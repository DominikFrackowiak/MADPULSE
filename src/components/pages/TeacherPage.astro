---
import TeacherPageHero from '../organisms/TeacherPageHero.astro'
import TeacherBiography from '../organisms/TeacherBiography.astro'
import WorkshopDescription from '../organisms/WorkshopDescription.astro'
import Quote from '../molecules/Quote.astro'

import type { teacherPages } from '../../../constants/constants'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

type TeacherPageData = (typeof teacherPages)[number]

interface Props {
	teacher: TeacherPageData
}

const { teacher } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const teacherTitle = t(teacher.title)
const quote = t(teacher.quote)
---

<TeacherPageHero teacher={teacher} teacherTitle={teacherTitle} />
<div class='mt-16'>
	<Quote text={quote} />
</div>
<div
	class='flex flex-col lg:flex-row justify-between items-center w-full mx-auto gap-8 lg:gap-16 max-w-screen-2xl py-0 lg:py-16 px-0 lg:px-10!'
>
	<TeacherBiography teacher={teacher} />
	<WorkshopDescription teacher={teacher} teacherTitle={teacherTitle} />
</div>
