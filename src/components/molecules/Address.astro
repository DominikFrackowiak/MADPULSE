---
interface Props {
	street: string
	closeTo: string
	metro: string
}
const { street, closeTo, metro } = Astro.props
---

<div
	class='flex flex-col gap-1 justify-center items-start lg:items-end w-full max-w-[470px] bg-custom-accent/80 text-white p-4 lg:p-8'
>
	<p class='flex items-start justify-end'>
		<span class='flex flex-col items-start lg:items-end'>
			<span class='text-start lg:text-end'>{street}</span>
			<span>{closeTo}</span>
		</span>
	</p>

	<p class='flex items-center justify-end'>
		<span>{metro}</span>
	</p>
</div>
