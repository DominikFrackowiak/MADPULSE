---
import { ui, defaultLang } from '../../i18n/ui'
import {
	getLangFromUrl,
	useTranslations,
	type TranslationKey,
} from '../../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

interface Props {
	text: string
}

const { text } = Astro.props

const isTranslationKey = (value: string): value is TranslationKey =>
	value in ui[defaultLang]

const quoteText = isTranslationKey(text) ? t(text) : text
---

<h2
	class='text-3xl md:text-7-3xl font-open-sans font-medium text-custom-accent text-center w-full max-w-screen-2xl mt-8 lg:mt-16 px-4! lg:px-16!'
>
	<i>&ldquo;{quoteText}&rdquo;</i>
</h2>
