---
import { cn } from 'utils/twMerge'
import { ui, defaultLang } from '../../i18n/ui'
import {
	getLangFromUrl,
	useTranslations,
	type TranslationKey,
} from '../../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

interface Props {
	text: string
	className?: string
}

const { text, className } = Astro.props

const isTranslationKey = (value: string): value is TranslationKey =>
	value in ui[defaultLang]

const quoteText = isTranslationKey(text) ? t(text) : text
---

<blockquote
	class={cn('text-2xl lg:text-7-3xl font-open-sans font-medium text-custom-accent text-center w-full max-w-screen-xl! mt-10 mb-4 px-4! lg:px-16! mx-auto!', className)}
>
	<i>&ldquo;{quoteText}&rdquo;</i>
</blockquote>
