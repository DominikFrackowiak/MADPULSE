---
import { cn } from 'utils/twMerge'
import Heading from '../atoms/Heading.astro'
import Amount from '../atoms/Amount.astro'

interface Props {
	title?: string
	amount?: string
	details?: string
	layout?: 'left' | 'right'
	isFeatured?: boolean
}

const {
	title,
	amount,
	details,

	isFeatured = false,
} = Astro.props
---

<div
	class={cn(
		'flex flex-col gap-1 py-4 px-2.5 w-full items-center',
		isFeatured ? 'bg-custom-accent-100' : 'bg-custom-accent/60'
	)}
>
	<Heading
		heading={title}
		customClass='text-3xl! items-center lg:items-start uppercase text-white text-center font-semibold!'
	/>

	<Amount text={amount} />
	<span class='block text-center lg:text-left text-lg! font-semibold text-white'
		>{details}</span
	>
</div>
