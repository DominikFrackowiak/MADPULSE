---
import {
	getLangFromUrl,
	useTranslations,
	type TranslationKey,
} from '../../i18n/utils'
import Quote from './Quote.astro'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

interface Props {
	text: string
	description?: TranslationKey
}

const { text, description = 'main.description' } = Astro.props
---

<div class='wrapper'>
	<div class='flex flex-col items-center gap-10 font-open-sans'>
		<Quote text={text} />
		<div class='h-[1px] w-1/5 bg-custom-blue'></div>
		<p class='font-open-sans text-custom-accent-200 text-center'>
			{t(description)}
		</p>
	</div>
</div>
