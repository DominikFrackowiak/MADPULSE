---
import { Image } from 'astro:assets'
import heroBackground from '../../assets/hero/background-hero.webp'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
import Footer from '../organisms/Footer.astro'
---

<div class='relative top-0 left-0 w-full z-0 h-dvh! max-h-dvh! overflow-hidden'>
	<Image
		src={heroBackground}
		alt=''
		class='absolute inset-0 z-0 h-full w-full object-cover object-[30%_center] lg:object-center'
		loading='eager'
	/>
	<div class='absolute inset-0 z-1 w-full h-full bg-white/20'></div>
	<div
		class='absolute z-2 top-1/2 left-0 -translate-y-1/2 lg:-translate-y-1/3 gap-2 lg:gap-2 right-0 flex flex-col w-full max-w-screen-4xl items-center lg:items-end justify-start font-newake text-6xl md:text-7xl 2xl:text-7xl text-white mx-auto my-0 px-4 lg:px-10'
	>
		<div class='flex flex-col gap-0 items-center lg:items-end'>
			<div class='flex gap-0 text-shadow-md leading-none'>
				<span class='font-newake tracking-tight font-extrabold'>MAD</span><span
					class='font-newake tracking-tight font-extrabold'>PULSE</span
				>
			</div>
			<span
				class='text-3xl font-newake font-extrabold tracking-tight text-shadow-md text-center'
			>
				{t('hero.description').toUpperCase()}
			</span>
		</div>
		<div
			class='flex flex-col text-4xl md:text-5xl justify-start items-center lg:items-end text-shadow-md'
		>
			<span
				class='font-newake font-extrabold leading-none tracking-tight text-center'
				>{t('hero.dates')}</span
			>
			<span class='font-newake font-extrabold leading-none tracking-tight'
				>MADRID</span
			>
		</div>

		<button
			class='mt-2 font-open-sans font-bold flex justify-center items-center hover:opacity-80
 bg-white
  text-sm
  text-almost-black
  rounded-4xl
  px-4
  py-2
  transition-opacity
  transition-discrete
  cursor-pointer
  shadow-2xl'
			><a href={`/${lang}/registration`}>{t('hero.CTA').toUpperCase()}</a
			></button
		>
	</div>
	<Footer isMain />
</div>
