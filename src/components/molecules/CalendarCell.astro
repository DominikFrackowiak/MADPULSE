---
interface Props {
	title: string
	teacher?: string | null
	hours: string
	day: string
	desktopOrder: number
}

const { title, teacher, hours, day, desktopOrder } = Astro.props
---

<div
	class='calendar-cell flex flex-col justify-between gap-3 items-start border-t-4 border-l-4 border-custom-accent-200 text-custom-accent-200 p-8 font-newake font-semibold'
	style={`--desktop-order: ${desktopOrder}`}
>
	<div class='flex flex-col gap-1'>
		<span class='block lg:hidden text-xl font-newake'>{day}</span>
		<span class='text-xl font-newake'>{hours}</span>
	</div>
	<div class='flex flex-col gap-1'>
		<span class='text-4xl font-bold font-newake'>{title}</span>
		{
			teacher ? (
				<span class='text-2xl font-bold font-newake'>{teacher}</span>
			) : null
		}
	</div>
</div>

<style>
	@media (min-width: 1024px) {
		.calendar-cell {
			order: var(--desktop-order);
		}
	}
</style>
