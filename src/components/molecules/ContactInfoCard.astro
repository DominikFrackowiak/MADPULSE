---
interface Props {
	name: string
	email: string
	phoneNumber: string
	whatsAppUrl?: string
}

import EnvelopeIcon from '../atoms/EnvelopeIcon.astro'
import WhatsappIcon from '../atoms/WhatsappIcon.astro'

const { name, email, phoneNumber, whatsAppUrl } = Astro.props
---

<div
	class='flex flex-col items-center px-2 py-4 text-white w-full bg-custom-accent/80 transition-colors'
>
	<span class='text-xl font-semibold leading-[1.6] py-1 text-white/90'
		>{name}</span
	>
	<div class='flex justify-start items-center gap-1 py-1'>
		<a href=`mailto:${email}`><EnvelopeIcon className='h-7 w-7 mt-1!' /></a>
		<a href=`mailto:${email}` class='text-xl leading-[1.6] font-normal'>
			{email}</a
		>
	</div>
	<div class='flex justify-start items-center gap-1 py-1'>
		<a aria-label='Chat on WhatsApp' href={whatsAppUrl}
			><WhatsappIcon className='h-6 w-6' /></a
		><a href={whatsAppUrl} class='text-xl leading-[1.6] font-normal'>
			{phoneNumber}</a
		>
	</div>
</div>
