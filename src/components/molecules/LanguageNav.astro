---
import { cn } from '../../../utils/twMerge'
import Dropdown from '../atoms/Dropdown.astro'
import GlobeIcon from '../atoms/GlobeIcon.astro'

interface Props {
	isMain: boolean
	lang: string
	currentPath: string
}

const languages = [
	{
		language: 'ESPAÑOL',
		id: 'es',
	},
	{
		language: 'ENGLISH',
		id: 'en',
	},
] as const

const { isMain, lang, currentPath } = Astro.props

const getPathForLang = (targetLang: string, currentPath: string) => {
	const segments = currentPath.split('/')
	segments[1] = targetLang
	return segments.join('/')
}
---

<Dropdown
	label='Language'
	buttonClassName='cursor-pointer text-white'
	contentClassName='min-w-30'
>
	<Fragment slot='trigger'>
		<GlobeIcon className='h-6 w-6' />
	</Fragment>
	{
		languages.map(l => (
			<a
				href={getPathForLang(l.id, currentPath)}
				class={cn(
					'cursor-pointer pb-0 font-open-sans !text-xs !3xl:text-md',
					l.id === lang ? 'border-b-2' : '',
					isMain && l.id === lang ? 'border-custom-green' : 'border-custom-blue'
				)}
				role='menuitem'
			>
				{l.language}
			</a>
		))
	}
</Dropdown>
