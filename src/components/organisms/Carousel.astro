---
const images = [
	{ src: '/images/space/1.jpeg', alt: 'Dance space 1' },
	{ src: '/images/space/2.jpeg', alt: 'Dance space 2' },
	{ src: '/images/space/3.jpeg', alt: 'Dance space 3' },
	{ src: '/images/space/4.jpeg', alt: 'Dance space 4' },
	{ src: '/images/space/5.jpeg', alt: 'Dance space 5' },
]
---

<div class='my-10 overflow-x-auto px-2'>
	<div class='grid auto-cols-[100%] grid-flow-col gap-4 lg:auto-cols-[calc((100%_-_2rem)/3)]'>
		{
			images.map(image => (
				<img
					src={image.src}
					alt={image.alt}
					class='h-[320px] w-full object-cover lg:h-[420px]'
					loading='lazy'
				/>
			))
		}
	</div>
</div>
