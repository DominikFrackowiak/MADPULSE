---
import SectionHeadingType2 from '@/components/atoms/SectionHeadingType2.astro'
import type { teacherPages } from '../../../constants/constants'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

type TeacherPageData = (typeof teacherPages)[number]

interface Props {
	teacher: TeacherPageData
}

const { teacher } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const imageOrderClass = teacher.isImageToTheLeft ? 'order-1' : 'order-2'
const imageEdgeClass = teacher.isImageToTheLeft
	? 'lg:ml-[calc((min(100vw,96rem)-100vw)/2)]'
	: 'lg:mr-[calc((min(100vw,96rem)-100vw)/2)]'
const descriptionOrderClass = teacher.isImageToTheLeft ? 'order-2' : 'order-1'

const getParagraphs = (text: string) =>
	text
		.split(/\n\s*\n/)
		.map(paragraph => paragraph.trim())
		.filter(Boolean)
---

<!-- <div class='flex flex-col lg:flex-col items-start w-full pb-8 max-w-screen-2xl'> -->
<div
	class='flex flex-col items-start gap-8 pb-16 w-full max-w-screen-2xl mx-auto'
>
	<div class='w-full flex items-center justify-between'>
		<SectionHeadingType2
			heading={teacher.name}
			customClass='items-start mt-8! max-w-[50px] text-custom-accent/85!'
		/>
		<quote
			class='text-3xl lg:text-7-3xl font-newake mt-8! font- inline-block text-custom-accent-100 text-right max-w-[400px] uppercase'
		>
		</quote>
	</div>
	<div
		class='flex flex-col lg:flex-row justify-between items-stretch w-full gap-8 lg:gap-16'
	>
		<div
			class:list={[
				'w-full lg:w-[calc(55%+(100vw-min(100vw,96rem))/2)] min-h-[460px]! lg:min-h-0 self-stretch bg-cover bg-center bg-no-repeat shadow-md mt-2 ',
				imageOrderClass,
				imageEdgeClass,
			]}
			style={`background-image: url('${teacher.imageSrc}')`}
		>
		</div>

		<div
			class:list={[
				'space-y-6 max-w-[38%] text-center md:text-left text-dark leading-relaxed',
				descriptionOrderClass,
			]}
		>
			{
				getParagraphs(t(teacher.description2)).map(paragraph => (
					<p>{paragraph}</p>
				))
			}
		</div>
	</div>
</div>
<!-- </div> -->
