---
import { cn } from '../../../utils/twMerge'
import Navigation from '../molecules/Navigation.astro'
import { getLangFromUrl } from '../../i18n/utils'
import LanguageNav from '../molecules/LanguageNav.astro'
import MobileNav from '../molecules/MobileNavigation.astro'
const { isMain } = Astro.props
const lang = getLangFromUrl(Astro.url)
const currentPath = Astro.url.pathname
---

<header
	class={cn(
		isMain ? 'bg-transparent' : 'bg-background',
		'fixed h-20  top-0 left-0 w-full z-20 transition-all duration-300 ease-in-out py-13!'
	)}
>
	<div
		class='flex justify-between items-center gap-6 w-full h-full max-w-screen-4xl mx-auto z-50 absolute top-0 left-1/2 -translate-x-1/2 px-4! lg:px-10!'
	>
		<a href={`/${lang}/`}
			><img src='/images/logo.webp' class='h-[55px] 3xl:h-[80px] z-50' /></a
		>

		<div class='flex h-24 gap-5 lg:gap-10 items-center justify-end w-1/2 py-4'>
			<Navigation
				currentPath={currentPath}
				isMain={isMain}
				isHeader
				lang={lang}
			/>
			<MobileNav isMain={isMain} currentPath={currentPath} lang={lang} />
			<div class='h-8'>
				<LanguageNav currentPath={currentPath} isMain={isMain} lang={lang} />
			</div>
		</div>
	</div>
</header>

