---
import { cn } from '@/lib/utils'
import Heading from '../atoms/Heading.astro'
import type { teacherPages } from '../../../constants/constants'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

type TeacherPageData = (typeof teacherPages)[number]

interface Props {
	teacher: TeacherPageData
}

const { teacher } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const getParagraphs = (text: string): string[] =>
	text
		.split(/\n\s*\n/)
		.map(paragraph => paragraph.trim())
		.filter(Boolean)
---

<div
	class={cn(
		'flex flex-col gap-8 lg:gap-16 w-full pt-2.5 py-8 lg:py-16 px-4 bg-white/90',
		teacher.biographySectionWidth
	)}
>
	<div class='flex flex-col gap-4'>
		<Heading
			heading={teacher.name}
			customClass={cn(
				'self-start items-start z-3 bg-custom text-custom-accent-200/70 uppercase'
			)}
		/>
		{
			getParagraphs(t(teacher.description2)).map(paragraph => (
				<p class='text-custom-accent-200'>{paragraph}</p>
			))
		}
	</div>
</div>
