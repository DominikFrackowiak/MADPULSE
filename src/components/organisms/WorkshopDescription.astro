---
import { cn } from 'utils/twMerge'
import Heading from '../atoms/Heading.astro'
import type { teacherPages } from '../../../constants/constants'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

type TeacherPageData = (typeof teacherPages)[number]

interface Props {
	teacher: TeacherPageData
	teacherTitle: string
}

const { teacher, teacherTitle } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const getParagraphs = (text: string) =>
	text
		.split(/\n\s*\n/)
		.map(paragraph => paragraph.trim())
		.filter(Boolean)
---

<div
	class={cn(
		'flex flex-col gap-8 lg:gap-16 w-full lg:w-1/2 bg-custom-accent/80 py-8 px-4! lg:px-8! lg:py-8',
		teacher.workshopSectionWidth
	)}
>
	<div class='flex flex-col gap-4 text-white'>
		<Heading
			heading={teacherTitle}
			customClass={cn(
				'self-start items-start text-white z-3 bg-custom  uppercase '
			)}
		/>
		{
			getParagraphs(t(teacher.description1)).map(paragraph => (
				<p>{paragraph}</p>
			))
		}
	</div>
</div>
